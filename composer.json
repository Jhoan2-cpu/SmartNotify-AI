{
    "name": "yourvendor/smartnotify-ai",
    "description": "Sistema avanzado de gestión de noticias con capacidades de IA para WordPress",
    "type": "wordpress-plugin",
    "keywords": [
        "wordpress",
        "plugin",
        "ai",
        "openai",
        "anthropic",
        "news",
        "sentiment-analysis",
        "content-generation"
    ],
    "homepage": "https://github.com/yourusername/smartnotify-ai",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Tu Nombre",
            "email": "tu@email.com",
            "homepage": "https://tu-sitio.com"
        }
    ],
    "support": {
        "issues": "https://github.com/yourusername/smartnotify-ai/issues",
        "source": "https://github.com/yourusername/smartnotify-ai"
    },
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "SmartNotifyAI\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SmartNotifyAI\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs --standard=WordPress includes/",
        "phpcbf": "phpcbf --standard=WordPress includes/"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
